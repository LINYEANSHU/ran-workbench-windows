  "cards": [
    {
      "dot": "emerald",
      "title": "一个窗口，独立状态",
      "items": [
        "Workbench 与 Strategy 分别维护状态及 JobRunner 实例。",
        "首次打开 Strategy 使用场景副本；显式更新会检查未保存内容并建立新实验。"
      ]
    },
    {
      "dot": "cyan",
      "title": "本机执行",
      "items": [
        "Qt 通过 ran:// 提供本地界面资源；可选 CLI 经令牌保护的回环 HTTP 调用。",
        "JobRunner 写入 input.json、读取 result.json；子进程通过 JSON 行发送进度。"
      ]
    },
    {
      "dot": "amber",
      "title": "计算边界",
      "items": [
        "传播求解及 RT 信道需要 CUDA；显式选择的策略合成演示使用独立路径。",
        "Modeling 精细网格只用于查看，不输入传播求解器。"
      ]
    }
  ]
