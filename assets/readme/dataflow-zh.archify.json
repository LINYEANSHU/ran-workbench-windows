  "cards": [
    {
      "dot": "emerald",
      "title": "场景到 RF",
      "items": [
        "手工编辑或文件导入形成已校验的场景状态；子进程返回 RF 结果。",
        "接收结果前检查场景指纹；导出由用户另行触发。"
      ]
    },
    {
      "dot": "cyan",
      "title": "场景到 NR",
      "items": [
        "实验同时接收场景副本与图 / 参数，不从覆盖计算结果推导。",
        "NR 生成信道快照，执行调度、CSI、链路自适应及 HARQ；实验指纹用于校验结果。"
      ]
    },
    {
      "dot": "amber",
      "title": "独立查看路径",
      "items": [
        "用户提供的精细网格仅进入 Modeling 和截图路径。",
        "场景与实验也可保存为 .ran.json 和 .ran-sim.json；它们是用户文件，不随软件分发。"
      ]
    }
  ]
