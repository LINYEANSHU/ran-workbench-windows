  "cards": [
    {
      "dot": "emerald",
      "title": "Scene to RF",
      "items": [
        "Manual edits or file import create validated scene state; the worker returns RF results.",
        "The scene fingerprint must match before a result is accepted; export is a separate user action."
      ]
    },
    {
      "dot": "cyan",
      "title": "Scene to NR",
      "items": [
        "The copied scene and graph/settings both enter the experiment; neither is inferred from RF results.",
        "NR derives channel snapshots and runs scheduling, CSI, link adaptation and HARQ; experiment fingerprints guard results."
      ]
    },
    {
      "dot": "amber",
      "title": "Independent viewing",
      "items": [
        "User-supplied meshes feed Modeling and screenshots only.",
        "Projects and experiments can also be saved as .ran.json and .ran-sim.json. They are user files, not bundled data."
      ]
    }
  ]
