  "cards": [
    {
      "dot": "emerald",
      "title": "One window, separate state",
      "items": [
        "Workbench and Strategy have their own controllers and JobRunner instances.",
        "Opening Strategy copies the scene; explicit refresh creates a new experiment after unsaved-change checks."
      ]
    },
    {
      "dot": "cyan",
      "title": "Local execution",
      "items": [
        "Qt serves bundled assets via ran://. The optional CLI calls token-protected loopback HTTP.",
        "JobRunner writes input.json and reads result.json; worker progress travels as JSON lines."
      ]
    },
    {
      "dot": "amber",
      "title": "Compute boundaries",
      "items": [
        "Propagation and the RT channel require CUDA. The explicitly selected synthetic Strategy fixture is a separate path.",
        "Detailed Modeling meshes are for viewing only and never feed the propagation solver."
      ]
    }
  ]
